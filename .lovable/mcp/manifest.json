            "limit": {
              "description": "Numărul maxim de biciclete returnate (implicit 20).",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "find_nearest_bike",
        "title": "Găsește cea mai apropiată bicicletă",
